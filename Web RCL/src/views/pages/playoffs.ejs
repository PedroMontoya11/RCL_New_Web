<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title }) %>

  <style>
    /* ===== HERO / TÍTULO ===== */
    .bracket-hero {
      text-align: left;
      padding: 30px 0 10px;
    }
    .bracket-hero .kicker {
      font-family: 'Orbitron', sans-serif;
      color: #fff;
      letter-spacing: .25em;
      font-size: .85rem;
      text-transform: uppercase;
    }
    .bracket-hero h1 {
      font-family: 'Orbitron', sans-serif;
      font-size: 3.2rem;
      color: #1FEEFF;
      text-transform: uppercase;
      font-weight: 900;
      letter-spacing: .02em;
      margin: 0;
      line-height: 1.1;
    }

    /* ===== CONTENEDOR GENERAL ===== */
    .bracket-rows {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 140px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 40px;
    }

    .bracket-section {
      display: flex;
      width: 100%;
      justify-content: center;
    }

    .bracket-side-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: 'Orbitron', sans-serif;
      font-size: .7rem;
      letter-spacing: .2em;
      color: #1FEEFF;
      text-transform: uppercase;
      align-self: stretch;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      flex-shrink: 0;
      margin-right: 30px;
    }

    .bracket-wrapper {
      display: flex;
      align-items: stretch;
      gap: 80px;
    }

    /* ===== COLUMNAS DE RONDA ===== */
    .round {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 56px;
      width: 300px;
      flex-shrink: 0;
    }

    .label-block {
      height: 56px;
      margin-bottom: 0;
    }

    .round-title {
      font-family: 'Orbitron', sans-serif;
      font-size: .85rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: #fff;
      line-height: 1.2;
      height: 22px;
    }
    .round-title.spacer {
      visibility: hidden;
    }

    .match-id {
      display: block;
      font-size: .7rem;
      color: #888888;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: .05em;
      height: 16px;
      margin-top: 6px;
    }
    .match-id .bo {
      color: #1FEEFF;
    }

    /* ===== TARJETAS DE EQUIPOS ===== */
    .match-card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 112px;
    }

    .team {
      flex: 1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 18px;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      color: #cccccc;
      text-transform: uppercase;
      background: none;
      border-radius: 0;
      border-bottom: 1px solid rgba(255,255,255,.2);
    }

    .team:last-child {
      border-bottom: none;
    }

    .team.winner {
      color: #fff;
    }

    .score {
      font-family: 'Orbitron', sans-serif;
      color: #1FEEFF;
      font-weight: 700;
      font-size: 1.1rem;
      margin-left: 14px;
      flex-shrink: 0;
    }

    /* ===== ICONO + NOMBRE DEL EQUIPO ===== */
    .team-icon {
      width: 26px;
      height: 26px;
      object-fit: contain;
      margin-right: 10px;
      flex-shrink: 0;
    }

    .team-name {
      display: flex;
      align-items: center;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    /* ============================================================
       LÍNEAS CONECTORAS
       ============================================================ */
    .match-card.line-out::after {
      content: '';
      position: absolute;
      top: 56px;
      right: -80px;
      width: 80px;
      height: 1px;
      background: rgba(255,255,255,.3);
    }

    .bracket-pair {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 56px;
    }

    .bracket-pair .match-card::after {
      content: '';
      position: absolute;
      top: 56px;
      right: -40px;
      width: 40px;
      height: 1px;
      background: rgba(255,255,255,.3);
    }

    .bracket-pair::after {
      content: '';
      position: absolute;
      top: 112px;
      height: 224px;
      right: -40px;
      width: 1px;
      background: rgba(255,255,255,.3);
    }

    .bracket-pair::before {
      content: '';
      position: absolute;
      top: 224px;
      right: -80px;
      width: 40px;
      height: 1px;
      background: rgba(255,255,255,.3);
    }

    @media (max-width: 1100px) {
      .bracket-wrapper {
        flex-wrap: wrap;
        gap: 60px;
      }
    }
  </style>
</head>
