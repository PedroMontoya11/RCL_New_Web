<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title }) %></head>
  <style>
    .main-title { text-align: center; font-weight: 800; font-size: 2.5rem; margin-bottom: 1rem; position: relative; }
    .main-title::after { content: ""; display: block; width: 100px; height: 5px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); margin: 15px auto 0; border-radius: 999px; }
  </style>
<body>
<div class="site-shell">
  <%- include('../partials/navbar') %>
  <section class="page-hero compact">
    <div class="container container-soft">
      <h1 class="main-title">Clasificación · <%= division %></h1>
      <p class="page-description">Resumen de victorias, derrotas y diferencia de mapas.</p>
      <div class="mt-3 d-flex gap-2 flex-wrap justify-content-center">
        <a class="btn btn-sm division-btn <%= division === 'Primera' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/clasificacion?division=Primera">
          Primera
        </a>
        <a class="btn btn-sm division-btn <%= division === 'Segunda' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/clasificacion?division=Segunda">
          Segunda
        </a>
      </div>
    </div>
  </section>
  <main class="container container-soft pb-5">
    <section class="table-panel">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead><tr><th>#</th><th>Equipo</th><th>Victorias</th><th>Derrotas</th><th>DM</th></tr></thead>
          <tbody>
            <% if (equipos.length) { equipos.forEach((fila, idx) => { const dm = Number(fila.diferencia_mapas || 0); const dmClase = dm > 0 ? 'text-success fw-bold' : dm < 0 ? 'text-danger fw-bold' : 'text-gris fw-bold'; %>
              <tr>
                <td><span class="badge-soft"><%= idx + 1 %></span></td>
                <td class="team-name <%= teamClass(fila.nombre, fila.class_color) %>"><a href="/equipos/<%= fila.id_equipo %>" style="color: inherit"><%= fila.nombre %></a></td>
                <td><%= fila.victorias %></td>
                <td><%= fila.derrotas %></td>
                <td class="<%= dmClase %>"><%= formatDM(fila.diferencia_mapas) %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="empty-state">No hay datos disponibles para esta división.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</div>
</body>
</html>
