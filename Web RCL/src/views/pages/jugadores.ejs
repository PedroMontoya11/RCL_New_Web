<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title }) %>

  <style>
    html,
    body {
      height: 100%;
    }

    body {
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    main {
      flex: 1 0 auto;
    }

    .header-wrapper {
      display: flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:2rem;
      margin-bottom:2rem; 
    }
    
    .title-container{
      display:flex;
      flex-direction:column;
      gap:.75rem;
    }

    .division-switch{
      align-self:flex-end;
      margin-bottom:.2rem;
    }

    @media (max-width: 991px){
      .header-wrapper{
        flex-direction:column;
        align-items:flex-start;
      }
      .division-switch{
        width:100%;
        justify-content:center;
      }
    }

    #mainTitle {
      font-weight: 800;
      margin-bottom: 0;
      position: relative;
      display: inline-block;
    }

    #mainTitle::after {
      content: "";
      display: block;
      width: 72px;
      height: 4px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      margin-top: 8px;
      border-radius: 999px;
    }

    .side-winrate{
      display:flex;
      align-items:center;
      gap:1rem;
      margin-top:.75rem;
    }

    .side-label{
      min-width:90px;
      font-size:.9rem;
      font-weight:700;
      color:#cccccc;
    }

    .side-label.blue{
      text-align:right;
    }

    .side-label.red{
      text-align:left;
    }

    .side-bar{
      flex:1;
      height:12px;
      border-radius:999px;
      overflow:hidden;
      position:relative;
      background:linear-gradient(90deg,#991b1b,#ef4444);
    }

    .side-bar-blue{
      height:100%;
      border-radius:999px;
      background:linear-gradient(90deg,#007a85,#1FEEFF);
    }

    /* Estilos botones filtro */
    .filtros{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:2rem;
      margin-bottom:1rem;
    }

    .button-filters{
      display:flex;
      gap:.75rem;
      align-items:center;
      margin-bottom:1rem;
    }

    .team-filters{
      justify-content:flex-end;
    }

    @media (max-width: 992px){
      .filtros{
          flex-direction:column;
          align-items:flex-start;
          gap:1rem;
      }
      .team-filters{
          justify-content:flex-start;
      }
    }
    
    .filter-btn{
      width:48px;
      height:48px;
      border:none;
      border-radius:12px;
      background:#111111;
      cursor:pointer;
      display:flex;
      justify-content:center;
      align-items:center;
      transition:.2s;
    }

    .filter-btn img{
      width:28px;
      height:28px;
      object-fit:contain;
      opacity:.75;
      transition:.2s;
    }

    .filter-btn:hover{
      background:#1a1a1a;
    }

    .filter-btn:hover img{
      opacity:1;
    }

    .filter-btn.active{
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      border-color:#fff;
      box-shadow:0 0 16px rgba(103,0,253,.45);
      transform:translateY(-2px);
    }

    .filter-btn.active img{
      opacity:1;
      transform:scale(1.1);
    }

    /* Estilos ranking */
    .ranking {
      background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .04));
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 1.25rem;
      box-shadow: var(--shadow);
    }

    @media (min-width: 768px) {
      .ranking {
        padding: 1.6rem;
      }
    }

    .players-table-wrap {
      border: 1px solid rgba(255, 255, 255, .08);
      border-radius: 18px;
      overflow: auto;
      background: rgba(0,0,0,.6);
    }

    .players-table {
      min-width: 1080px;
      margin: 0 !important;
      background: transparent !important;
    }

    .players-table thead th {
      background: rgba(255, 255, 255, .04) !important;
      color: #ffffff !important;
      font-weight: 800;
      border-bottom: 1px solid rgba(255, 255, 255, .12) !important;
      text-transform: uppercase;
      font-size: .8rem;
      letter-spacing: .08em;
      padding: .95rem .85rem;
    }
    
    .players-table tbody td {
      color: #ffffff !important;
      font-weight: 700;
      border-top: 1px solid rgba(255, 255, 255, .08) !important;
      vertical-align: middle;
      background: transparent !important;
      padding: .95rem .85rem;
    }

    .players-table tbody tr:nth-child(odd) {
      background: rgba(255, 255, 255, .025);
    }

    .players-table tbody tr:hover {
      background: rgba(103, 0, 253, .12);
    }

    .players-table .text-start {
      color: #fff !important;
    }

    .img-rol {
      width: 30px;
      height: 30px;
      object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, .35));
    }

    .sort-select {
      background: rgba(0, 0, 0, .35);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, .14);
      border-radius: 12px;
      padding: .65rem .95rem;
      outline: none;
      min-width: 180px;
    }

    .sort-select:focus {
      border-color: rgba(31, 238, 255, .55);
      box-shadow: 0 0 0 .2rem rgba(103, 0, 253, .16);
    }

    .stat-badge {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      color: #fff;
      font-weight: 800;
      padding: 8px 12px;
      border-radius: 12px;
      min-width: 85px;
      display: inline-block;
      text-align: center;
      box-shadow: 0 10px 22px rgba(103, 0, 253, .22);
    }

    .small.text-secondary {
      color: var(--muted) !important;
    }

    .team-cell {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
    }

    .team-cell img {
      width: 24px;
      height: 24px;
      object-fit: contain;
    }

    .filters-row {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .division-switch a {
      min-width: 110px;
    }

    .meta-box {
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      padding: 1rem 1.1rem;
      color: #ffffff;
      font-weight: 700;
    }

    .sortable{
      cursor:pointer;
      position:relative;
      transition:.2s;
    }

    .sortable::after{
      content:"";
      position:absolute;
      left:15%;
      bottom:6px;
      width:70%;
      height:2px;
      border-radius:999px;
      background:linear-gradient(90deg,var(--accent),var(--accent-2));
      transform:scaleX(0);
      transition:.2s;
    }

    .sortable:hover::after,
    .sortable.active::after{
      transform:scaleX(1);
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container my-5">
    <div class="header-wrapper">
      <div class="title-container">
        <h2 id="mainTitle">Stats Jugadores · <%= division %></h2>
        <div class="side-winrate">
          <span class="side-label blue">
            Azul <strong><%= Number(blueWR || 0).toFixed(2) %>%</strong>
          </span>

          <div class="side-bar">
            <div
              class="side-bar-blue"
              style="width:<%= Number(blueWR || 0).toFixed(2) %>%">
            </div>
          </div>

          <span class="side-label red">
            <strong><%= Number(redWR || 0).toFixed(2) %>%</strong> Rojo
          </span>
        </div>
      </div>

      <div class="division-switch d-flex gap-2 flex-wrap justify-content-center">
        <a class="btn btn-sm division-btn <%= division === 'Primera' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/jugadores?division=Primera&sort=<%= sortOption %>">
          Primera
        </a>
        <a class="btn btn-sm division-btn <%= division === 'Segunda' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/jugadores?division=Segunda&sort=<%= sortOption %>">
          Segunda
        </a>
      </div>
  
    </div>

    <section class="filtros"> 
      <div class="button-filters role-filters mb-3">
        <% ['Top','Jungla','Mid','ADC','Support','Polivalente'].forEach(r => { %>
          <button
            class="filter-btn role-filter <%= role === r ? 'active' : '' %>"
            data-filter="role"
            data-value="<%= r %>"
            title="<%= r %>">

            <img src="<%= roleIcon(r) %>" alt="<%= r %>">
          </button>
        <% }) %>
      </div>
      
      <div class="button-filters team-filters mb-3">
        <% equipos.forEach(e => { %>
          <button
            class="filter-btn team-filter <%= team === e.nombre ? 'active' : '' %>"
            data-filter="team"
            data-value="<%= e.nombre %>"
            title="<%= e.nombre %>">

            <img src="<%= teamLogo(e.nombre) %>" alt="<%= e.nombre %>">
          </button>
        <% }) %>
      </div>
    </section>
  
    <section class="ranking">
      <div class="players-table-wrap">
        <%
          const sortableColumns = [
            { key: 'kda', label: 'KDA' },
            { key: 'cs', label: 'CS/min' },
            { key: 'dmg', label: 'DMG/min' },
            { key: 'winrate', label: 'Winrate' },
            { key: 'mvp', label: 'MVPs' }
          ];
        %>
        <table class="table players-table align-middle mb-0 text-center">
          <thead>
            <tr>
              <th>#</th>
              <th class="text-start">Jugador</th>
              <th>Rol</th>
              <th>Equipo</th>

              <% sortableColumns.forEach(col => { %>
                <th class="sortable" data-sort="<%= col.key %>">
                  <%= col.label %>
                  <% if (sortOption === col.key) { %>
                    <%= order === 'desc' ? '▼' : '▲' %>
                  <% } %>
                </th>
              <% }) %>

              <th>Mapas</th>
              <th>OP.GG</th>
            </tr>
          </thead>

          <tbody>
            <% ranking.forEach((f, idx) => {
              const logo = teamLogo(f.equipo);

              const winrate = Number(f.winrate) || 0;
              const kda = Number(f.kda) || 0;

              const winrateGradient =
                winrate < 50
                  ? `linear-gradient(90deg, rgba(127,29,29,.85), rgba(239,68,68,${0.65 + Math.min(Math.abs(winrate-50)/50,1)*0.35}))`
                  : `linear-gradient(90deg, rgba(26,0,106,.85), rgba(103,0,253,${0.65 + Math.min(Math.abs(winrate-50)/50,1)*0.35}))`;


              const kdaGradient =
                kda < 1
                  ? 'linear-gradient(90deg, rgba(127,29,29,.85), rgba(239,68,68,.95))'
                  : 'linear-gradient(90deg, rgba(26,0,106,.85), rgba(103,0,253,.95))';

              const opggUrl = `https://op.gg/es/lol/summoners/euw/${encodeURIComponent(f.nombre_usuario)}-${encodeURIComponent((f.riot_tag || '').replace('#',''))}`;
            %>
              <tr data-role="<%= f.rol %>">
                <td><%= idx + 1 %></td>

                <td class="text-start">
                  <%= f.nombre_usuario %>
                  <% if (f.riot_tag) { %>
                    <div class="small text-secondary"><%= f.riot_tag %></div>
                  <% } %>
                </td>

                <td>
                  <img
                    class="img-rol"
                    src="<%= roleIcon(f.rol) %>"
                    alt="<%= f.rol %>"
                    onerror="this.onerror=null; this.src='/assets/img/liga.png'"
                  >
                </td>

                <td>
                  <span class="team-cell">
                    <img
                      src="<%= logo %>"
                      alt="<%= f.equipo %>"
                      onerror="this.onerror=null; this.src='/assets/img/liga.png'"
                    >
                    <span><%= f.equipo %></span>
                  </span>
                </td>

                <td>
                  <span class="stat-badge" style="background:<%= kdaGradient %>;">
                    <%= kda.toFixed(2) %>
                  </span>
                </td>

                <td><%= Number(f.cs_min).toFixed(2) %></td>

                <td><%= Number(f.dmg_min).toFixed(0) %></td>

                <td>
                  <span class="stat-badge" style="background:<%= winrateGradient %>;">
                    <%= winrate.toFixed(2) %>%
                  </span>
                </td>

                <td><%= f.total_mvps %></td>

                <td><%= f.mapas %></td>

                <td>
                  <a
                    class="btn btn-sm btn-outline-light"
                    href="<%= opggUrl %>"
                    target="_blank"
                    rel="noreferrer"
                  >
                    Abrir
                  </a>
                </td>
              </tr>
            <% }) %>
            <% if (!ranking.length) { %>
              <tr><td colspan="11">No hay estadísticas registradas</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Script para filtrar por rol o equipo -->
    <script>
      document.querySelectorAll(".filter-btn").forEach(button => {
        button.addEventListener("click", () => {
          const params = new URLSearchParams(window.location.search);

          const filter = button.dataset.filter;
          const value = button.dataset.value;

          if (params.get(filter) === value) {
              params.delete(filter);
          } else {
              params.set(filter, value);
          }

          window.location.search = params.toString();
        });
      });
    </script>
  </main>

  <!-- Script para ordenar por estadisticas -->
  <script>
    document.querySelectorAll(".sortable").forEach(th => {
      th.addEventListener("click", () => {
          const params = new URLSearchParams(window.location.search);

          const sort = th.dataset.sort;
          const currentSort = params.get("sort");
          const currentOrder = params.get("order") || "desc";

          let newOrder = "desc";

          if (currentSort === sort) {
            newOrder = currentOrder === "desc" ? "asc" : "desc";
          }

          params.set("sort", sort);
          params.set("order", newOrder);

          window.location.search = params.toString();
      });
    });
  </script>

  <%- include('../partials/footer') %>
</body>
</html>