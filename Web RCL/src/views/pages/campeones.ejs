<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title }) %>
  <style>
    .main-title { text-align: center; font-weight: 800; font-size: 2.5rem; margin-bottom: 1rem; position: relative; }
    .main-title::after { content: ""; display: block; width: 100px; height: 5px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); margin: 15px auto 0; border-radius: 999px; }

    .sort-form{
      display:flex;
      gap:.75rem;
      align-items:center;
      margin-bottom:1rem;
    }

    @media (max-width: 992px){
      .sort-form{
        flex-direction:column;
        align-items:flex-start;
        gap:1rem;
      }
    }

    .sort-btn{
      padding:0 14px;
      height:40px;
      min-width:90px;

      border:none;
      border-radius:12px;
      background:#111111;
      cursor:pointer;

      display:flex;
      justify-content:center;
      align-items:center;

      color:#fff;
      font-size:14px;
      font-weight:500;

      transition:.2s;
    }

    .sort-btn:hover{
      background:#1a1a1a;
    }

    .sort-btn.active{
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      box-shadow:0 0 16px rgba(103,0,253,.45);
      transform:translateY(-2px);
    }

    .sort-btn.active:hover{
      filter:brightness(1.05);
    }

    .champ-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .champ-card {
      background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.04));
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 1.1rem;
      box-shadow: var(--shadow);
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .champ-card img {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 18px;
    }

    .champ-meta {
      font-size: .92rem;
      color: var(--muted);
    }

    .champ-stats {
      display: flex;
      flex-direction: column;
      gap: .15rem;
      line-height: 1.35;
    }

    .champ-title {
      font-weight: 800;
      margin-bottom: .35rem;
    }

    .wr-badge {
      display: inline-block;
      padding: .35rem .65rem;
      border-radius: 999px;
      font-weight: 800;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      color: #000;
    }

    .sort-form {
      margin: 0;
    }

    .sort-select {
      background: rgba(0,0,0,0.9);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 16px;
      color: #fff;
      padding: .55rem 1rem;
      min-width: 170px;
      font-weight: 700;
      outline: none;
      box-shadow: var(--shadow);
      transition: .2s ease;
    }

    .sort-select:hover {
      border-color: rgba(255,255,255,.25);
    }

    .sort-select:focus {
      border-color: var(--accent);
    }
  </style>
</head>

<body>
<div class="site-shell">

  <%- include('../partials/navbar') %>

  <section class="page-hero compact">
    <div class="container container-soft">
      <h1 class="main-title">
        Campeones jugados · <%= division %>
      </h1>

      <p class="page-description">
        Games jugados y winrate por campeón.
      </p>

      <div class="mt-3 d-flex gap-3 flex-wrap justify-content-center align-items-center">
        <div class="d-flex gap-2">
          <a class="btn btn-sm division-btn <%= division === 'Primera' ? 'btn-brand' : 'btn-outline-light' %>" href="/campeones?division=Primera&sort=<%= sort || 'nombre' %>">Primera</a>
          <a class="btn btn-sm division-btn <%= division === 'Segunda' ? 'btn-brand' : 'btn-outline-light' %>" href="/campeones?division=Segunda&sort=<%= sort || 'nombre' %>">Segunda</a>
        </div>
      </div>
      <div class="mt-3 d-flex gap-3 flex-wrap justify-content-center align-items-center"> 
        <form method="GET" action="/campeones" class="sort-form">
            <input type="hidden" name="division" value="<%= division %>">
            <% ['nombre','winrate','partidas'].forEach(op => { %>
              <button
                type="submit"
                name="sort"
                value="<%= op %>"
                class="sort-btn <%= sort === op ? 'active' : '' %>"
              >
                <%= op.charAt(0).toUpperCase() + op.slice(1) %>
              </button>
            <% }) %>
          </form>
        </div>
    </div>
  </section>

  <main class="container container-soft pb-5">

    <div class="champ-grid">
      <% champions.forEach((champ) => { %>

        <article class="champ-card">

          <img
            src="/assets/img/champs/<%= slugChampion(champ.nombre) %>.png"
            alt="<%= champ.nombre %>"
            onerror="this.onerror=null; this.src='/assets/img/liga.png'"
          >

          <div>

            <div class="champ-title">
              <%= champ.nombre %>
            </div>

            <div class="champ-meta champ-stats">
              <span><%= champ.partidas %> partidas</span>
              <span><%= champ.victorias %> victorias</span>
              <span><%= champ.derrotas %> derrotas</span>
            </div>

            <div class="mt-2">
              <span class="wr-badge">
                <%= Number(champ.winrate).toFixed(0) %>% WR
              </span>
            </div>

          </div>

        </article>

      <% }) %>
    </div>

    <% if (!champions.length) { %>
      <div class="empty-state mt-4">
        No hay picks registrados en esta divisi�n.
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>

</div>
</body>
</html>