<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../../partials/head', { title }) %>
    <style>
      body {
        min-height: 100vh;
      }

      .admin-page {
        padding: 3rem 0 4rem;
      }

      .admin-hero {
        text-align: center;
        margin-bottom: 2.25rem;
      }

      .admin-hero-logo {
        width: 96px;
        height: 96px;
        object-fit: contain;
        margin-bottom: 1rem;
        filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.32));
      }

      .admin-hero-title {
        margin-bottom: 0.5rem;
      }

      .admin-hero-text {
        color: var(--muted);
        margin: 0 auto;
        max-width: 760px;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .admin-link-card {
        display: block;
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.04));
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 1.6rem;
        box-shadow: var(--shadow);
        transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
        min-height: 220px;
      }

      .admin-link-card:hover {
        transform: translateY(-4px);
        border-color: rgba(248, 113, 113, 0.34);
        box-shadow: 0 20px 44px rgba(0, 0, 0, 0.3);
      }

      .admin-link-icon {
        width: 58px;
        height: 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        box-shadow: 0 10px 22px rgba(124, 58, 237, 0.22);
      }

      .admin-link-card h2 {
        margin-bottom: 0.6rem;
        font-size: 1.1rem;
      }

      .admin-link-card p {
        margin: 0;
        color: var(--muted);
      }

      .admin-footer-links {
        margin-top: 2rem;
        text-align: center;
      }

      .admin-footer-links a {
        margin: 0 0.75rem;
      }

      .logout-link {
        color: #f87171;
      }

      @media (max-width: 900px) {
        .admin-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <%- include('../../partials/navbar') %>

    <main class="container admin-page">
      <section class="admin-hero">
        <img class="admin-hero-logo" src="/assets/img/liga.png" alt="Logo RCL" />
        <h1 class="admin-hero-title">Panel de administración</h1>
        <p class="admin-hero-text">
          Gestiona picks, estadísticas y consulta el contenido de las tablas desde una interfaz
          más limpia y coherente con el resto de la web.
        </p>
      </section>

      <section class="admin-grid">
        <a href="/admin/picks-equipos" class="admin-link-card">
          <div class="admin-link-icon" aria-hidden="true">
            <svg width="26" height="26" fill="#fff" viewBox="0 0 24 24">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z" />
            </svg>
          </div>
          <h2>Picks equipos</h2>
          <p>Registra campeones pickeados y el resultado final de cada selección.</p>
        </a>

        <a href="/admin/match-stats" class="admin-link-card">
          <div class="admin-link-icon" aria-hidden="true">
            <svg width="26" height="26" fill="#fff" viewBox="0 0 24 24">
              <path d="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z" />
            </svg>
          </div>
          <h2>Stats jugadores</h2>
          <p>Guarda kills, deaths, assists, daño, lado, victoria y MVP por jugador.</p>
        </a>

        <a href="/admin/info-tablas" class="admin-link-card">
          <div class="admin-link-icon" aria-hidden="true">
            <svg width="26" height="26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="3" y1="15" x2="21" y2="15"></line>
              <line x1="10" y1="3" x2="10" y2="21"></line>
            </svg>
          </div>
          <h2>Ver tablas</h2>
          <p>Consulta el contenido de las tablas permitidas directamente desde el panel.</p>
        </a>
      </section>

      <div class="admin-footer-links">
        <a href="/">← Ir a la web</a>
        <a href="/admin/logout" class="logout-link">Cerrar sesión</a>
      </div>
    </main>

    <%- include('../../partials/footer') %>
  </body>
</html>
