<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../../partials/head', { title }) %>
    <style>
      .admin-page {
        padding: 3rem 0 4rem;
      }

      .admin-header {
        max-width: 980px;
        margin: 0 auto 1.5rem;
        text-align: center;
      }

      .admin-header img {
        width: 76px;
        height: 76px;
        object-fit: contain;
        margin-bottom: 0.75rem;
      }

      .admin-header p {
        color: var(--muted);
        margin: 0.45rem auto 0;
        max-width: 760px;
      }

      .admin-filter-card,
      .admin-table-card,
      .admin-empty-card {
        max-width: 980px;
        margin: 0 auto;
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.04));
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }

      .admin-filter-card {
        padding: 1.25rem;
        margin-bottom: 1.25rem;
      }

      .admin-filter-card label {
        display: block;
        margin-bottom: 0.45rem;
        color: #f5f7ff;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .admin-table-card {
        padding: 1rem;
        overflow: hidden;
      }

      .admin-table-wrap {
        overflow: auto;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(7, 5, 20, 0.45);
      }

      .admin-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
      }

      .admin-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: rgba(255,255,255,0.06);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.95rem 0.85rem;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        white-space: nowrap;
      }

      .admin-table tbody td {
        color: #eef2ff;
        font-weight: 700;
        padding: 0.9rem 0.85rem;
        border-top: 1px solid rgba(255,255,255,0.08);
        text-align: center;
        white-space: nowrap;
      }

      .admin-table tbody tr:nth-child(odd) {
        background: rgba(255,255,255,0.02);
      }

      .admin-table tbody tr:hover {
        background: rgba(124, 58, 237, 0.1);
      }

      .admin-empty-card {
        padding: 1.25rem;
        color: var(--muted);
        text-align: center;
      }

      .admin-bottom-link {
        max-width: 980px;
        margin: 1.1rem auto 0;
      }

      .admin-bottom-link a {
        color: var(--muted);
      }
    </style>
  </head>

  <body>
    <%- include('../../partials/navbar') %>

    <main class="container admin-page">
      <header class="admin-header">
        <img src="/assets/img/liga.png" alt="Logo RCL" />
        <h1>Consulta de tablas</h1>
        <p>
          Visualiza el contenido de las tablas permitidas con un estilo unificado y más legible.
        </p>
      </header>

      <section class="admin-filter-card">
        <form method="GET">
          <label for="tabla">Selecciona una tabla</label>
          <select id="tabla" name="tabla" onchange="this.form.submit()">
            <% allowedTables.forEach((t) => { %>
              <option value="<%= t %>" <%= t === table ? 'selected' : '' %>>
                <%= t.charAt(0).toUpperCase() + t.slice(1) %>
              </option>
            <% }) %>
          </select>
        </form>
      </section>

      <% if (rows.length) { %>
        <section class="admin-table-card">
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <% columns.forEach((col) => { %>
                    <th><%= col %></th>
                  <% }) %>
                </tr>
              </thead>

              <tbody>
                <% rows.forEach((row) => { %>
                  <tr>
                    <% columns.forEach((col) => { %>
                      <td><%= row[col] %></td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      <% } else { %>
        <section class="admin-empty-card">
          No hay datos en esta tabla.
        </section>
      <% } %>

      <div class="admin-bottom-link">
        <a href="/admin">← Volver al inicio</a>
      </div>
    </main>

    <%- include('../../partials/footer') %>
  </body>
</html>
