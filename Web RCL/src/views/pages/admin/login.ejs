<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../../partials/head', { title }) %>
    <style>
      html,
      body {
        min-height: 100%;
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background:
          radial-gradient(circle at top, rgba(124, 58, 237, 0.16), transparent 35%),
          radial-gradient(circle at bottom right, rgba(225, 29, 72, 0.12), transparent 30%),
          var(--bg-main);
      }

      .admin-auth-shell {
        width: 100%;
        max-width: 460px;
      }

      .admin-auth-card {
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.04));
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 2rem;
        box-shadow: var(--shadow);
        backdrop-filter: blur(10px);
      }

      .admin-auth-logo {
        width: 78px;
        height: 78px;
        object-fit: contain;
        display: block;
        margin: 0 auto 1rem;
        filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.32));
      }

      .admin-auth-title {
        margin: 0 0 0.35rem;
        text-align: center;
        color: #fff;
        font-weight: 800;
        letter-spacing: 0.04em;
      }

      .admin-auth-subtitle {
        margin: 0 0 1.5rem;
        text-align: center;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .admin-field {
        margin-bottom: 1rem;
      }

      .admin-field label {
        display: block;
        margin-bottom: 0.45rem;
        color: #f5f7ff;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .admin-field input {
        width: 100%;
      }

      .admin-error {
        margin-top: 1rem;
        border: 1px solid rgba(239, 68, 68, 0.28);
        background: rgba(127, 29, 29, 0.22);
        color: #fecaca;
        border-radius: 14px;
        padding: 0.9rem 1rem;
        font-weight: 700;
      }

      .admin-auth-actions {
        margin-top: 1.25rem;
      }

      .admin-auth-actions .button {
        width: 100%;
        text-align: center;
      }

      .admin-auth-back {
        margin-top: 1.1rem;
        text-align: center;
      }

      .admin-auth-back a {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .admin-auth-back a:hover {
        color: #fff;
      }
    </style>
  </head>

  <body>
    <main class="admin-auth-shell">
      <section class="admin-auth-card">
        <img class="admin-auth-logo" src="/assets/img/liga.png" alt="Logo RCL" />

        <h1 class="admin-auth-title">Panel Staff</h1>
        <p class="admin-auth-subtitle">Acceso de administración</p>

        <form method="POST" action="/admin/login">
          <div class="admin-field">
            <label for="username">Usuario</label>
            <input id="username" type="text" name="username" required />
          </div>

          <div class="admin-field">
            <label for="password">Contraseña</label>
            <input id="password" type="password" name="password" required />
          </div>

          <div class="admin-auth-actions">
            <button type="submit" class="button">Acceder al panel</button>
          </div>

          <% if (error) { %>
            <div class="admin-error"><%= error %></div>
          <% } %>
        </form>

        <div class="admin-auth-back">
          <a href="/">← Volver a la web</a>
        </div>
      </section>
    </main>
  </body>
</html>
