<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title }) %></head>
  <style>
    .main-title { text-align: center; font-weight: 800; font-size: 2.5rem; margin-bottom: 1rem; position: relative; }
    .main-title::after { content: ""; display: block; width: 100px; height: 5px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); margin: 15px auto 0; border-radius: 999px; }

    .grid-auto{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:1rem;
    }

    .grid-auto > *{
      flex:0 0 305px;
    }
  </style>
<body>
<div class="site-shell">
  <%- include('../partials/navbar') %>
  <section class="page-hero compact">
    <div class="container container-soft">
      <h1 class="main-title">Equipos · <%= division %></h1>
      <p class="page-description">Accede al detalle de cada plantilla y a sus mejores picks</p>
      <div class="mt-3 d-flex gap-2 flex-wrap justify-content-center">
        <a class="btn btn-sm division-btn <%= division === 'Primera' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/equipos?division=Primera">
          Primera
        </a>
        <a class="btn btn-sm division-btn <%= division === 'Segunda' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/equipos?division=Segunda">
          Segunda
        </a>
      </div>
    </div>
  </section>
  <main class="container container-soft pb-5">
    <div class="grid-auto">
      <% equipos.forEach((equipo) => { %>
        <a href="/equipos/<%= equipo.id_equipo %>" class="card-glass card-hover text-center p-4">
          <img src="<%= teamLogo(equipo.nombre) %>" alt="<%= equipo.nombre %>" class="team-logo mb-3" style="width:120px;height:82px;" onerror="this.onerror=null; this.src='/assets/img/liga.png'">
          <h2 class="h5 mb-1 team-card-title <%= equipo.class_color %>"><%= equipo.nombre %></h2>
          <div class="text-secondary"><%= equipo.division %> · Ver plantilla y campeones</div>
        </a>
      <% }) %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</div>
</body>
</html>
