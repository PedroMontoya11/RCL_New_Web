<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title }) %>

  <style>
    html,
    body {
      height: 100%;
    }

    body {
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    main {
      flex: 1 0 auto;
    }

    .header-wrapper {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 2rem;
      align-items: center;
    }

    @media (min-width: 992px) {
      .header-wrapper {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    #mainTitle {
      font-weight: 800;
      margin-bottom: 0;
      position: relative;
      display: inline-block;
    }

    #mainTitle::after {
      content: "";
      display: block;
      width: 72px;
      height: 4px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      margin-top: 8px;
      border-radius: 999px;
    }

    .ranking {
      background: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(255, 255, 255, .04));
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 1.25rem;
      box-shadow: var(--shadow);
    }

    @media (min-width: 768px) {
      .ranking {
        padding: 1.6rem;
      }
    }

    .players-table-wrap {
      border: 1px solid rgba(255, 255, 255, .08);
      border-radius: 18px;
      overflow: auto;
      background: rgba(7, 5, 20, .6);
    }

    .players-table {
      min-width: 1080px;
      margin: 0 !important;
      background: transparent !important;
    }

    .players-table thead th {
      background: rgba(255, 255, 255, .04) !important;
      color: #f6f7ff !important;
      font-weight: 800;
      border-bottom: 1px solid rgba(255, 255, 255, .12) !important;
      text-transform: uppercase;
      font-size: .8rem;
      letter-spacing: .08em;
      padding: .95rem .85rem;
    }
    
    .players-table tbody td {
      color: #eef2ff !important;
      font-weight: 700;
      border-top: 1px solid rgba(255, 255, 255, .08) !important;
      vertical-align: middle;
      background: transparent !important;
      padding: .95rem .85rem;
    }

    .players-table tbody tr:nth-child(odd) {
      background: rgba(255, 255, 255, .025);
    }

    .players-table tbody tr:hover {
      background: rgba(124, 58, 237, .12);
    }

    .players-table .text-start {
      color: #fff !important;
    }

    .img-rol {
      width: 30px;
      height: 30px;
      object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, .35));
    }

    .sort-select {
      background: rgba(0, 0, 0, .35);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, .14);
      border-radius: 12px;
      padding: .65rem .95rem;
      outline: none;
      min-width: 180px;
    }

    .sort-select:focus {
      border-color: rgba(251, 113, 133, .55);
      box-shadow: 0 0 0 .2rem rgba(225, 29, 72, .16);
    }

    .stat-badge {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      color: #fff;
      font-weight: 800;
      padding: 8px 12px;
      border-radius: 12px;
      min-width: 85px;
      display: inline-block;
      text-align: center;
      box-shadow: 0 10px 22px rgba(124, 58, 237, .22);
    }

    .small.text-secondary {
      color: var(--muted) !important;
    }

    .team-cell {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
    }

    .team-cell img {
      width: 24px;
      height: 24px;
      object-fit: contain;
    }

    .filters-row {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .division-switch a {
      min-width: 110px;
    }

    .meta-box {
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      padding: 1rem 1.1rem;
      color: #eef2ff;
      font-weight: 700;
    }

    .role-filters{
    display:flex;
    gap:.75rem;
    align-items:center;
    margin-bottom:1rem;
    }
    
    .role-filter{
        width:48px;
        height:48px;
        border:none;
        border-radius:12px;
        background:#181a2b;
        cursor:pointer;
        display:flex;
        justify-content:center;
        align-items:center;
        transition:.2s;
    }

    .role-filter img{
        width:28px;
        height:28px;
        object-fit:contain;
        opacity:.75;
        transition:.2s;
    }

    .role-filter:hover{
        background:#23253d;
    }

    .role-filter:hover img{
        opacity:1;
    }

    .role-filter.active{
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      border-color:#fff;
      box-shadow:0 0 16px rgba(155,89,255,.45);
      transform:translateY(-2px);
    }

    .role-filter.active img{
        opacity:1;
        transform:scale(1.1);
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container my-5">
    <div class="header-wrapper">
      <div class="title-container">
        <h2 id="mainTitle">Stats Jugadores · <%= division %></h2>
        <div class="small text-secondary mt-2">
          Azul <%= Number(blueWR || 0).toFixed(2) %>% ·
          Rojo <%= Number(redWR || 0).toFixed(2) %>%
        </div>
      </div>

      <div class="division-switch d-flex gap-2 flex-wrap justify-content-center">
        <a class="btn btn-sm division-btn <%= division === 'Primera' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/jugadores?division=Primera&sort=<%= sortOption %>">
          Primera
        </a>
        <a class="btn btn-sm division-btn <%= division === 'Segunda' ? 'btn-brand' : 'btn-outline-light' %>"
          href="/jugadores?division=Segunda&sort=<%= sortOption %>">
          Segunda
        </a>
      </div>
    
      <div class="role-filters mb-3">
        <% ['Top','Jungla','Mid','ADC','Support'].forEach(role => { %>
          <button class="role-filter" data-role="<%= role %>" title="<%= role %>"><img src="<%= roleIcon(role) %>" alt="<%= role %>"></button>
        <% }) %>
      </div> 
    </div>
  
    <section class="ranking">
      <div class="players-table-wrap">
        <table class="table players-table align-middle mb-0 text-center">
          <thead>
            <tr>
              <th>#</th>
              <th class="text-start">Jugador</th>
              <th>Rol</th>
              <th>Equipo</th>

              <th class="sortable" data-sort="kda"> 
                KDA
                <% if (sortOption === 'kda') { %>
                  <%= order === 'desc' ? '▼' : '▲' %>
                <% } %>
              </th>

              <th class="sortable" data-sort="cs">
                CS/min
                <% if (sortOption === 'cs') { %>
                  <%= order === 'desc' ? '▼' : '▲' %>
                <% } %>
              </th>

              <th class="sortable" data-sort="dmg">
                DMG/min
                <% if (sortOption === 'dmg') { %>
                  <%= order === 'desc' ? '▼' : '▲' %>
                <% } %>
              </th>

              <th class="sortable" data-sort="winrate">
                Winrate
                <% if (sortOption === 'winrate') { %>
                  <%= order === 'desc' ? '▼' : '▲' %>
                <% } %>
              </th>

              <th class="sortable" data-sort="mvp">
                MVPs
                <% if (sortOption === 'mvp') { %>
                  <%= order === 'desc' ? '▼' : '▲' %>
                <% } %>
              </th>
              <th>Mapas</th>
              <th>OP.GG</th>
            </tr>
          </thead>
          <tbody>
            <% ranking.forEach((f, idx) => {
              const logo = teamLogo(f.equipo);
              const winrate = Number(f.winrate) || 0;
              const distance = Math.abs(winrate - 50);
              const intensity = Math.min(distance / 50, 1);

              let gradient;
              if (winrate < 50) {
                gradient = `linear-gradient(90deg, rgba(127,29,29,0.85), rgba(239,68,68,${0.65 + intensity * 0.35}))`;
              } else {
                gradient = `linear-gradient(90deg, rgba(30,58,138,0.85), rgba(59,130,246,${0.65 + intensity * 0.35}))`;
              }

              const kda = Number(f.kda) || 0;
              let kdaGradient;
              if (kda < 1) {
                kdaGradient = `linear-gradient(90deg, rgba(127,29,29,0.85), rgba(239,68,68,0.95))`;
              } else {
                kdaGradient = `linear-gradient(90deg, var(--accent), var(--accent-2))`;
              }

              const opggUrl = `https://op.gg/es/lol/summoners/euw/${encodeURIComponent(f.nombre_usuario)}-${encodeURIComponent((f.riot_tag || '').replace('#', ''))}`;
            %>
              <tr data-role="<%= f.rol %>">
                <td><%= idx + 1 %></td>
                <td class="text-start">
                  <%= f.nombre_usuario %>
                  <% if (f.riot_tag) { %>
                    <div class="small text-secondary"><%= f.riot_tag %></div>
                  <% } %>
                </td>
                <td>
                  <img class="img-rol" src="<%= roleIcon(f.rol) %>" alt="<%= f.rol %>" onerror="this.onerror=null; this.src='/assets/img/liga.png'">
                </td>
                <td>
                  <span class="team-cell">
                    <img src="<%= logo %>" alt="<%= f.equipo %>" onerror="this.onerror=null; this.src='/assets/img/liga.png'">
                    <span><%= f.equipo %></span>
                  </span>
                </td>
                <td>
                  <span class="stat-badge" style="background: <%= kdaGradient %>;">
                    <%= Number(f.kda || 0).toFixed(2) %>
                  </span>
                </td>
                <td><%= Number(f.cs_min || 0).toFixed(2) %></td>
                <td><%= Number(f.dmg_min || 0).toFixed(0) %></td>
                <td>
                  <span class="stat-badge" style="background: <%= gradient %>;">
                    <%= winrate.toFixed(2) %>%
                  </span>
                </td>
                <td><%= f.total_mvps %></td>
                <td><%= f.mapas %></td>
                <td>
                  <a class="btn btn-sm btn-outline-light" href="<%= opggUrl %>" target="_blank" rel="noreferrer">Abrir</a>
                </td>
              </tr>
            <% }) %>
            <% if (!ranking.length) { %>
              <tr><td colspan="11">No hay estadísticas registradas en esta división.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- TODO DEVOLVER DESDE BACKEND UNICAMENTE LOS JUGADORES DEL ROL SELECCIONADO -->
    <!-- Script para filtrar por rol -->
    <script>
      const filters = document.querySelectorAll(".role-filter");
      const rows = document.querySelectorAll(".players-table tbody tr");

      // Leer parámetros de la URL
      const params = new URLSearchParams(window.location.search);
      let currentRole = params.get("role") || "";

      // Aplicar el filtro inicial al cargar la página
      if (currentRole) {
          const activeButton = document.querySelector(`.role-filter[data-role="${currentRole}"]`);

          if (activeButton) {
              activeButton.classList.add("active");
          }

          rows.forEach(row => {
              if (!row.dataset.role) return;

              row.style.display =
                  row.dataset.role === currentRole ? "" : "none";
          });
      }

      filters.forEach(filter => {
        filter.addEventListener("click", function () {
          // Si se pulsa el mismo botón, quitar el filtro
          if (currentRole === this.dataset.role) {
              currentRole = "";
              filters.forEach(btn => btn.classList.remove("active"));
          } else {
              currentRole = this.dataset.role;

              filters.forEach(btn => btn.classList.remove("active"));
              this.classList.add("active");
          }

          // Guardar el filtro en la URL sin recargar
          if (currentRole === "") {
              params.delete("role");
          } else {
              params.set("role", currentRole);
          }

          window.history.replaceState({}, "", "?" + params.toString());

          // Aplicar filtro
          rows.forEach(row => {
            // Ignorar filas que no representan jugadores
            if (!row.dataset.role) return;
            // Mostrar solo los jugadores del rol seleccionado
            if (currentRole === "" || row.dataset.role === currentRole) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
          });
        });
      });
    </script>
  </main>

  <!-- Script para ordenar por estadisticas -->
  <script>
    document.querySelectorAll(".sortable").forEach(th => {
      th.addEventListener("click", () => {
          const params = new URLSearchParams(window.location.search);

          const sort = th.dataset.sort;
          const currentSort = params.get("sort");
          const currentOrder = params.get("order") || "desc";

          let newOrder = "desc";

          if (currentSort === sort) {
            newOrder = currentOrder === "desc" ? "asc" : "desc";
          }

          params.set("sort", sort);
          params.set("order", newOrder);

          window.location.search = params.toString();
      });
    });
  </script>

  <%- include('../partials/footer') %>
</body>
</html>